local template
for _, p in W.Ground:GetChildren() do
	local z = p:IsA("BasePart") and p.Position.Z
	if z and z < NEAR and z > FAR and p.Size.Y <= 4 and math.abs(p.CFrame.RightVector.X) > 0.999 then
		if not template and p.Name == "Ground" then
			template = p:Clone()
		end
		p:Destroy()
	end
end
assert(template, "no fourth-biome Ground in World2.Ground to copy the look of")
for _, t in template:GetChildren() do
	if not t:IsA("Texture") then
		t:Destroy()
	end
end
for k in template:GetAttributes() do
	template:SetAttribute(k, nil)
end
local n = 0
local function lay(name, x, z, sx, sz, colour, checker)
	local p = template:Clone()
	p.Name = name
	p.Size = Vector3.new(sx, 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, -1, z - sz / 2)
	p.Color = colour
	for _, t in p:GetChildren() do
		if checker then
			t.Color3 = checker
		else
			t:Destroy() -- (boards: plain, no checker)
		end
	end
	p.Parent = W.Ground
	n += 1
end
for _, r in FLOOR do
	local k = KINDS[r[1]]
	lay(k[1], r[2] + OFFSET, r[3], r[4], r[5], k[2], k[3])
end
return string.format("%d floor parts", n)
