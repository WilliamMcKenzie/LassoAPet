local template
for _, p in W.Ground:GetChildren() do
	if p:IsA("BasePart") and p:GetAttribute("ArcBase") then
		template = template or p:Clone()
		p:Destroy()
	end
end
assert(template, "no ArcBase floor in World2.Ground to copy the look of")
for _, t in template:GetChildren() do
	if not t:IsA("Texture") then
		t:Destroy()
	end
end
for _, r in FLOOR do
	local k = KINDS[r[1]]
	local x, z, sx, sz = r[2] + OFFSET, r[3], r[4], r[5]
	local p = template:Clone()
	p.Name = k[1]
	p.Size = Vector3.new(sx, k[2] + 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, (k[2] - 2) / 2, z + sz / 2)
	p.Color = k[3]
	for _, t in p:GetChildren() do
		t.Color3 = k[4]
	end
	p.Parent = W.Ground
end

local function dirtAt(x, z)
	for _, r in FLOOR do
		if r[1] == 2 and x >= r[2] + OFFSET and x < r[2] + OFFSET + r[4] and z >= r[3] and z < r[3] + r[5] then
			return true
		end
	end
	return false
end
local dropped = 0
local plants = W.BaseDecor:FindFirstChild("Plants")
if plants then
	for _, m in plants:GetChildren() do
		local at = m:GetPivot().Position
		if dirtAt(at.X, at.Z) then
			m:Destroy()
			dropped += 1
		end
	end
end
return string.format("%d floor parts, %d plants on dirt dropped", #FLOOR, dropped)
