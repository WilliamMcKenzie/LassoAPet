-- World 2's third biome, the Crystal Cavern (QM, Oct 13; draft). Made by
-- tools/world2_cavern.py: edit that and re-make this, not this. Run in Studio (Edit,
-- execute_luau) on the place with World2, after tools/world2_terrain.luau. Re-running is fine.
-- Floor a gradient from the walls in (#5A6D8F, #6281A7, #74BAD5), the darkest never
-- touching the lightest, and two long stretches of wooden planks down the middle.
-- Replaces World2's copied floor between the second biome and the fourth (World 1's
-- Tundra floor: its flat parts there) and paints the walls there #384867.
local W = workspace.World2
local OFFSET = 1000
local NEAR, FAR = -3984, -5904
local rgb = Color3.fromRGB
local KINDS = { -- [kind] = { name, part colour, checker colour }
	[0] = { "Ground", rgb(90, 109, 143), rgb(82, 99, 131) }, -- #5A6D8F
	[1] = { "Ice", rgb(98, 129, 167), rgb(89, 118, 153) }, -- #6281A7
	[2] = { "Crystal", rgb(116, 186, 213), rgb(105, 171, 197) }, -- #74BAD5
}
local BOARDS = { rgb(150, 98, 56), rgb(132, 84, 46) } -- planks: 4-stud boards across the course, alternating
local WALL, WALL_CHECKER, CAP = rgb(56, 72, 103), rgb(48, 62, 90), rgb(44, 57, 82) -- #384867
-- { kind, low x, near z, size x, size z } in game space (x before the offset); kind 3 = planks
local FLOOR = {
--FLOOR--
}

local template
for _, p in W.Ground:GetChildren() do
	local z = p:IsA("BasePart") and p.Position.Z
	if z and z < NEAR and z > FAR and p.Size.Y <= 4 and math.abs(p.CFrame.RightVector.X) > 0.999 then
		if not template and p.Name == "Ground" then
			template = p:Clone()
		end
		p:Destroy()
	end
end
assert(template, "no third-biome Ground in World2.Ground to copy the look of")
for _, t in template:GetChildren() do
	if not t:IsA("Texture") then
		t:Destroy()
	end
end
for k in template:GetAttributes() do
	template:SetAttribute(k, nil)
end
local n = 0
local function lay(name, x, z, sx, sz, colour, checker)
	local p = template:Clone()
	p.Name = name
	p.Size = Vector3.new(sx, 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, -1, z - sz / 2)
	p.Color = colour
	for _, t in p:GetChildren() do
		if checker then
			t.Color3 = checker
		else
			t:Destroy() -- (boards: plain, no checker)
		end
	end
	p.Parent = W.Ground
	n += 1
end
for _, r in FLOOR do
	local x, z, sx, sz = r[2] + OFFSET, r[3], r[4], r[5]
	if r[1] == 3 then
		for b = 0, sz / 4 - 1 do
			local bz = z - b * 4
			lay("Planks", x, bz, sx, 4, BOARDS[((NEAR - bz) / 4) % 2 + 1])
		end
	else
		local k = KINDS[r[1]]
		lay(k[1], x, z, sx, sz, k[2], k[3])
	end
end

local walls = 0
for _, p in W.Walls:GetChildren() do
	if p:IsA("BasePart") and p.Position.Z < NEAR and p.Position.Z > FAR then
		if p.Name == "Cap" then
			p.Color = CAP
		else
			p.Color = WALL
			for _, t in p:GetChildren() do
				if t:IsA("Texture") then
					t.Color3 = WALL_CHECKER
				end
			end
		end
		walls += 1
	end
end
return string.format("%d floor parts, %d walls painted", n, walls)
