-- World 2's sixth and last biome, the Ancient Tomb (QM, Oct 13; draft). Made by
-- tools/world2_tomb.py: edit that and re-make this, not this. Run in Studio (Edit,
-- execute_luau) on the place with World2, after tools/world2_terrain.luau. Re-running is fine.
-- Two-tone sand dunes, diamond-paved stretches, a gold causeway a stud up, and royal gold
-- daises two up in darker gold borders. Replaces World2's copied floor past the fifth biome
-- (World 1's Jurassic floor: its flat parts there) and paints the walls there #D3B742.
local W = workspace.World2
local OFFSET = 1000
local NEAR, FAR = -14064, -21744
local rgb = Color3.fromRGB
local KINDS = { -- [kind] = { name, part colour, checker colour }
	[0] = { "Sand", rgb(220, 201, 152), rgb(210, 191, 142) }, -- #DCC998
	[1] = { "Dune", rgb(208, 184, 134), rgb(198, 174, 124) }, -- #D0B886
	[2] = { "Paving", rgb(208, 184, 134), rgb(198, 174, 124) },
	[3] = { "Gold", rgb(226, 194, 0), rgb(196, 167, 3) }, -- #E2C200 / #C4A703
	[4] = { "Gold", rgb(226, 194, 0), rgb(196, 167, 3) },
	[5] = { "Frame", rgb(196, 167, 3), rgb(180, 152, 2) },
}
local WALL, WALL_CHECKER, CAP = rgb(211, 183, 66), rgb(196, 168, 54), rgb(186, 158, 46) -- #D3B742
-- { kind, low x, near z, size x, size z, top } in game space (x before the offset)
local FLOOR = {
--FLOOR--
}

local template
for _, p in W.Ground:GetChildren() do
	local z = p:IsA("BasePart") and p.Position.Z
	if z and z < NEAR and z > FAR and p.Size.Y <= 5 and math.abs(p.CFrame.RightVector.X) > 0.999 then
		if not template and p.Name == "Ground" then
			template = p:Clone()
		end
		p:Destroy()
	end
end
template = template or W.Ground:FindFirstChildWhichIsA("BasePart"):Clone()
for _, t in template:GetChildren() do
	if not t:IsA("Texture") then
		t:Destroy()
	end
end
for k in template:GetAttributes() do
	template:SetAttribute(k, nil)
end
local n = 0
local function lay(name, x, z, sx, sz, top, colour, checker)
	local p = template:Clone()
	p.Name = name
	p.Size = Vector3.new(sx, top + 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, (top - 2) / 2, z - sz / 2)
	p.Color = colour
	for _, t in p:GetChildren() do
		if checker then
			t.Color3 = checker
		else
			t:Destroy() -- (boards: plain, no checker)
		end
	end
	p.Parent = W.Ground
	n += 1
end
for _, r in FLOOR do
	local k = KINDS[r[1]]
	lay(k[1], r[2] + OFFSET, r[3], r[4], r[5], r[6], k[2], k[3])
end

local walls = 0
for _, p in W.Walls:GetChildren() do
	if p:IsA("BasePart") and p.Position.Z < NEAR and p.Position.Z > FAR then
		if p.Name == "Cap" then
			p.Color = CAP
		else
			p.Color = WALL
			for _, t in p:GetChildren() do
				if t:IsA("Texture") then
					t.Color3 = WALL_CHECKER
				end
			end
		end
		walls += 1
	end
end
return string.format("%d floor parts, %d walls painted", n, walls)
