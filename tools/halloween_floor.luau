local function floorAt(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { W.Ground }
	local hit = workspace:Raycast(Vector3.new(pos.X, 50, pos.Z), Vector3.new(0, -100, 0), params)
	return if hit then hit.Position.Y else 0
end

local standing = {}
local function note(inst)
	if inst:IsA("Model") or inst:IsA("BasePart") then
		table.insert(standing, { inst, floorAt(inst:GetPivot().Position) })
	end
end
local decor = W:FindFirstChild("BaseDecor")
for _, inst in decor and decor:GetDescendants() or {} do
	if inst.Parent == decor or (inst.Parent and inst.Parent:IsA("Folder") and inst.Parent.Parent == decor) then
		note(inst)
	end
end
local spawn = W:FindFirstChild("SpawnLocation", true) or workspace:FindFirstChild("SpawnLocation")
if spawn then
	note(spawn)
end

-- The old floor: tools/halloween_base.luau's one Grass part (to the bin), or this script's
-- own parts from a run before.
local SS = game:GetService("ServerStorage")
local bin = SS:FindFirstChild("HalloweenStripped") or Instance.new("Folder")
bin.Name = "HalloweenStripped"
bin.Parent = SS
local template
for _, p in W.Ground:GetChildren() do
	if p:IsA("BasePart") and p:GetAttribute("HalloweenBase") then
		template = p:Clone()
		p.Parent = bin
	elseif p:IsA("BasePart") and p:GetAttribute("HalloweenFloor") then
		template = template or p:Clone()
		p:Destroy()
	end
end
assert(template, "no Halloween base floor in World.Ground: run tools/halloween_base.luau first")
template:SetAttribute("HalloweenBase", nil)
template:SetAttribute("HalloweenFloor", true)
local checker
for _, t in template:GetChildren() do
	if t:IsA("Texture") and not checker then
		checker = t
	else
		t:Destroy()
	end
end
for _, r in FLOOR do
	local k = KINDS[r[1]]
	local x, z, sx, sz = r[2], r[3], r[4], r[5]
	local p = template:Clone()
	p.Name = k[1]
	p.Size = Vector3.new(sx, k[2] + 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, (k[2] - 2) / 2, z + sz / 2)
	p.Color = k[3]
	for _, t in p:GetChildren() do
		t.Color3 = k[4]
	end
	p.Parent = W.Ground
end

local moved = 0
for _, s in standing do
	local inst, before = s[1], s[2]
	local dy = floorAt(inst:GetPivot().Position) - before
	if math.abs(dy) > 0.01 then
		inst:PivotTo(inst:GetPivot() + Vector3.new(0, dy, 0))
		moved += 1
	end
end
return string.format("%d floor parts, %d things moved with the floor", #FLOOR, moved)
