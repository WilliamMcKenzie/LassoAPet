local rgb = Color3.fromRGB
local ROCKS = { rgb(153, 146, 135), rgb(129, 124, 115), rgb(173, 166, 150), rgb(140, 137, 117), rgb(164, 153, 144) }
local TUFTS = { rgb(231, 182, 88), rgb(214, 166, 74) }
local STEM, PETAL, CENTRE = rgb(58, 120, 48), rgb(222, 52, 56), rgb(255, 196, 40)
local SMALL = { GrassTuft = true, Flower = true, StoneTile = true, StoneTile2 = true, StoneTile3 = true }

-- The floor's top under (x, z), and whether it's dirt (as Shared/Ground, on the 8-stud grid).
local tops, dirt = {}, {}
local function key(x, z)
	return math.floor(x / 8) .. "," .. math.floor(z / 8)
end
for _, p in ROOT.Ground:GetChildren() do
	if p.Position.Z > -2300 then
		local top = p.Position.Y + p.Size.Y / 2
		local lo = p.Position - p.Size / 2
		for x = lo.X + 4, lo.X + p.Size.X, 8 do
			for z = lo.Z + 4, lo.Z + p.Size.Z, 8 do
				tops[key(x, z)] = top
				dirt[key(x, z)] = p.Name == "Dirt" or nil
			end
		end
	end
end
local function topAt(pos)
	return tops[key(pos.X, pos.Z)] or 0
end

for _, d in ROOT:GetDescendants() do
	if d:GetAttribute("W1Decor") then
		d:Destroy()
	end
end

local meshes = {}
local function make(e)
	local p
	if e.m then
		meshes[e.m] = meshes[e.m] or AssetService:CreateMeshPartAsync(Content.fromUri(e.m))
		p = meshes[e.m]:Clone()
	else
		p = Instance.new(e.c)
	end
	p.Name = e.n
	p.Size = Vector3.new(e.s[1], e.s[2], e.s[3])
	p.CFrame = CFrame.new(table.unpack(e.f)) + OFF
	p.Color = Color3.fromHex(e.col)
	p.Material = Enum.Material[e.mat]
	p.MaterialVariant = e.mv
	p.Transparency, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = e.tr, e.cc, e.cq, e.ct, e.cs
	p.Anchored = true
	for k, v in e.a do
		p:SetAttribute(k, v)
	end
	return p
end

local folders = {
	Plants = ROOT.BaseDecor:FindFirstChild("Plants"),
	BaseDecor = ROOT.BaseDecor,
	Obstacles = ROOT.Obstacles,
}
local placed, skipped, rock = 0, 0, 0
for _, item in ITEMS do
	local name = item.n or item.single.n
	local at = Vector3.new(table.unpack(item.pivot or item.single.f, 1, 3)) + OFF
	if SMALL[name] and dirt[key(at.X, at.Z)] then
		skipped += 1
		continue
	end
	local lift = topAt(at) -- (World 1's floor there is at 0)
	local inst
	if item.single then
		inst = make(item.single)
		rock += 1
		inst.Color = ROCKS[(rock - 1) % #ROCKS + 1]
		inst.Position += Vector3.new(0, lift, 0)
	else
		inst = Instance.new("Model")
		inst.Name = name
		for k, v in item.a do
			inst:SetAttribute(k, v)
		end
		local shade = 0
		for i, e in item.parts do
			local p = make(e)
			if name == "GrassTuft" then
				p.Color = TUFTS[i % 2 + 1]
			elseif name == "Flower" then
				p.Color = if i == 1 then STEM elseif i == 2 then PETAL else CENTRE
			elseif e.m and not SMALL[name] then -- a rock's meshes (not its Base)
				shade += 1
				p.Color = ROCKS[(rock + shade - 1) % #ROCKS + 1]
			end
			p.Parent = inst
		end
		rock += 1
		inst.WorldPivot = CFrame.new(table.unpack(item.pivot)) + OFF
		inst:PivotTo(inst:GetPivot() + Vector3.new(0, lift, 0))
	end
	inst:SetAttribute("W1Decor", true)
	inst.Parent = folders[item.folder]
	placed += 1
end

-- And what was already there sits on its tile too: the pines, the portal gate, the spawn.
local seated = 0
local function seat(inst, base)
	local pivot = inst:GetPivot()
	local want = topAt(pivot.Position) + (base or 0)
	inst:PivotTo(pivot + Vector3.new(0, want - pivot.Position.Y, 0))
	seated += 1
end
for _, m in folders.Plants:GetChildren() do
	if m.Name:match("^Pine") then
		seat(m)
	end
end
seat(ROOT.BaseDecor.PortalGate)
local spawn = ROOT:FindFirstChild("SpawnLocation")
if spawn then
	seat(spawn, spawn.Size.Y / 2)
end
return placed .. " placed, " .. skipped .. " over dirt left out, " .. seated .. " seated"
