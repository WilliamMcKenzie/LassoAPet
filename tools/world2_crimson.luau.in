-- World 2's second biome, the Crimson Lands (QM, Oct 13; draft). Made by
-- tools/world2_crimson.py: edit that and re-make this, not this. Run in Studio (Edit,
-- execute_luau) on the place with World2, after tools/world2_terrain.luau. Re-running is fine.
-- Crimson ground, brighter crimson patches, and single stone tiles always ringed by the
-- brighter crimson (each a stud higher: ground 0, brighter 1, stone 2), with World 1's base stone plates scattered round each stone tile.
-- Replaces World2's copied floor between the first biome and the third (World 1's Desert
-- floor: its flat Ground, Grass and Stone parts there) and lays World2.Decor.Plates.
-- Walls, obstacles and nests stay (placeholders for now).
local W = workspace.World2
local OFFSET = 1000
local NEAR, FAR = -2168, -3984
local rgb = Color3.fromRGB
local KINDS = { -- [kind] = { name, part colour, checker colour }
	[0] = { "Ground", rgb(121, 20, 37), rgb(110, 17, 33) }, -- #791425
	[1] = { "Crimson", rgb(144, 44, 43), rgb(132, 38, 38) }, -- #902C2B
	[2] = { "Stone", rgb(119, 86, 86), rgb(108, 77, 77) }, -- #775656
}
local PLATE_MESHES = { 111341018632779, 79901946489032, 99868534966094 } -- (tools/lobby_plants.luau: StoneTile, 2, 3)
local PLATE_COLOURS = { rgb(119, 86, 86), rgb(132, 98, 98) }
-- { kind, low x, near z, size x, size z, top } in game space (x before the offset); tops 0, 1, 2
local FLOOR = {
--FLOOR--
}
-- { x, z, variant, yaw (degrees), y }: plates on 4-stud squares
local PLATES = {
--PLATES--
}

local template
for _, p in W.Ground:GetChildren() do
	local z = p:IsA("BasePart") and p.Position.Z
	if z and z < NEAR and z > FAR and p.Size.Y <= 5 and (p.Name == "Ground" or p.Name == "Grass" or p.Name == "Stone" or p.Name == "Crimson") then
		if not template and p.Name == "Ground" then
			template = p:Clone()
		end
		p:Destroy()
	end
end
assert(template, "no second-biome Ground in World2.Ground to copy the look of")
for _, t in template:GetChildren() do
	if not t:IsA("Texture") then
		t:Destroy()
	end
end
for k in template:GetAttributes() do
	template:SetAttribute(k, nil)
end
for _, r in FLOOR do
	local k = KINDS[r[1]]
	local x, z, sx, sz = r[2] + OFFSET, r[3], r[4], r[5]
	local p = template:Clone()
	p.Name = k[1]
	p.Size = Vector3.new(sx, r[6] + 2, sz)
	p.CFrame = CFrame.new(x + sx / 2, (r[6] - 2) / 2, z - sz / 2)
	p.Color = k[2]
	for _, t in p:GetChildren() do
		t.Color3 = k[3]
	end
	p.Parent = W.Ground
end

-- The plates (walk over them; no shadow), at 1x like the base's, studded.
local AssetService = game:GetService("AssetService")
local studs = game:GetService("MaterialService"):FindFirstChild("Studs", true)
local folder = W.Decor:FindFirstChild("Plates")
if folder then
	folder:Destroy()
end
folder = Instance.new("Folder")
folder.Name = "Plates"
local meshes = {}
for i, r in PLATES do
	local id = PLATE_MESHES[r[3]]
	meshes[id] = meshes[id] or AssetService:CreateMeshPartAsync(Content.fromUri("rbxassetid://" .. id))
	local p = meshes[id]:Clone()
	p.Name = "Plate"
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.Color = PLATE_COLOURS[(i % 2) + 1]
	if studs then
		p.Material = studs.BaseMaterial
		p.MaterialVariant = studs.Name
	end
	p.CFrame = CFrame.new(r[1] + OFFSET, r[5], r[2]) * CFrame.Angles(0, math.rad(r[4]), 0)
	p.Parent = folder
end
folder.Parent = W.Decor
-- The nests stand on whatever tile is under them now (raised tiles would bury them).
local function topAt(x, z)
	for _, r in FLOOR do
		local x0 = r[2] + OFFSET
		if x >= x0 and x < x0 + r[4] and z <= r[3] and z > r[3] - r[5] then
			return r[6]
		end
	end
	return 0
end
local nests = 0
for _, m in W.Nests:GetChildren() do
	local pivot = m:GetPivot()
	if pivot.Z < NEAR and pivot.Z > FAR then
		local baseY = m:GetAttribute("FlatY") or pivot.Y -- (where it stood on the flat floor)
		m:SetAttribute("FlatY", baseY)
		m:PivotTo(pivot + Vector3.new(0, baseY + topAt(pivot.X, pivot.Z) - pivot.Y, 0))
		nests += 1
	end
end
return string.format("%d floor parts, %d plates, %d nests raised", #FLOOR, #PLATES, nests)
